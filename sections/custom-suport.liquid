<div class="slider-section">
  <div class="image-slider-main-contaoiner page-width">
    <div class="img-slider flex">
      {% for block in section.blocks %}
          {% if block.settings.slide-image != blank %}
       
          <div class="slider-containerr">
          <img class="slider-item-image" src="{{ block.settings.slide-image | img_url:'master'}}" loading="lazy">
            <div class="para-had">
             <h4>{{ block.settings.heading }}</h4>
               <p class="shiping">{{ block.settings.slide-heading }}</p>
            </div>
          </div>
         
       
        {% endif %}
      {% endfor %}
        
    </div>
  </div>
</div>

