document.addEventListener('DOMContentLoaded', function () {

  const desktopSlides = document.querySelectorAll('.testimonial-text');
  const desktopDots = document.querySelectorAll('.dot');
  let currentIndexDesktop = 0;
  const intervalTime = 3000;
  
  function showDesktopSlide(index) {
    desktopSlides.forEach((slide, i) => {
      slide.classList.toggle('highlighted', i === index);
      desktopDots[i].classList.toggle('active', i === index);
    });
  }
  
  function autoplayDesktopSlider() {
    currentIndexDesktop = (currentIndexDesktop + 1) % desktopSlides.length;
    showDesktopSlide(currentIndexDesktop);
  }
  
  let autoplayDesktop = setInterval(autoplayDesktopSlider, intervalTime);
  
  desktopDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      currentIndexDesktop = i;
      showDesktopSlide(currentIndexDesktop);
      clearInterval(autoplayDesktop);
      autoplayDesktop = setInterval(autoplayDesktopSlider, intervalTime);
    });
  });

  
  const mobileSlides = document.querySelectorAll('.testimonial-slide');
  const mobileDots = document.querySelectorAll('.dot');
  let currentIndexMobile = 0;

  function showMobileSlide(index) {
    mobileSlides.forEach((slide, i) => {
      slide.style.display = i === index ? 'block' : 'none';
      mobileDots[i].classList.toggle('active', i === index);
    });
  }

  function autoplayMobileSlider() {
    currentIndexMobile = (currentIndexMobile + 1) % mobileSlides.length;
    showMobileSlide(currentIndexMobile);
  }

  let autoplayMobile;

  function startAutoplayIfMobile() {
    if (window.innerWidth <= 768) {
      autoplayMobile = setInterval(autoplayMobileSlider, intervalTime);
    } else {
      clearInterval(autoplayMobile); 
    }
  }

  mobileDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      currentIndexMobile = i;
      showMobileSlide(currentIndexMobile);
      clearInterval(autoplayMobile); 
      autoplayMobile = setInterval(autoplayMobileSlider, intervalTime); 
    });
  });

  // Check screen size on load and resize
  function initSlider() {
    if (window.innerWidth > 768) {
    
      showDesktopSlide(currentIndexDesktop);
      document.querySelector('.desktop-slider').style.display = 'block';
      document.querySelector('.mobile-slider').style.display = 'none';
      clearInterval(autoplayMobile);  // Ensure mobile slider doesn't run
    } else {
   
      showMobileSlide(currentIndexMobile);
      document.querySelector('.desktop-slider').style.display = 'none';
      document.querySelector('.mobile-slider').style.display = 'block';
      startAutoplayIfMobile();
    }
  }

  window.addEventListener('resize', initSlider);

  
  initSlider();
});


</script>

